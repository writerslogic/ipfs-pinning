    "VerifiableCredentialAssertion": "wlp:VerifiableCredentialAssertion",

    "verdict": {
      "@id": "wlp:verdict",
      "@type": "xsd:string",
      "@context": {
        "@protected": true,
        "human-authored": "wlp:verdict-human-authored",
        "mixed-input": "wlp:verdict-mixed-input",
        "transcriptive": "wlp:verdict-transcriptive",
        "insufficient": "wlp:verdict-insufficient"
      }
    },

    "attestationTier": {
      "@id": "wlp:attestationTier",
      "@type": "xsd:integer",
      "@context": {
        "@protected": true,
        "software-only": "wlp:tier-software-only",
        "attested-software": "wlp:tier-attested-software",
        "hardware-bound": "wlp:tier-hardware-bound"
      }
    },

    "contentTier": {
      "@id": "wlp:contentTier",
      "@type": "xsd:string",
      "@context": {
        "@protected": true,
        "core": "wlp:content-core",
        "enhanced": "wlp:content-enhanced",
        "maximum": "wlp:content-maximum"
      }
    },

    "writingMode": {
      "@id": "wlp:writingMode",
      "@type": "xsd:string"
    },
    "compositionMode": {
      "@id": "wlp:compositionMode",
