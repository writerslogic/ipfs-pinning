{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "wlp": "https://writerslogic.com/ns/v1/",
    "prov": "http://www.w3.org/ns/prov#",
    "cred": "https://www.w3.org/2018/credentials#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rats": "urn:ietf:params:rats:",
    "schema": "https://schema.org/",

    "ProcessAttestationCredential": "wlp:ProcessAttestationCredential",
    "AuthorshipCredential": "wlp:AuthorshipCredential",
    "AuthorshipClaim": "wlp:AuthorshipClaim",
    "ProcessAttestation": "wlp:ProcessAttestation",
    "PopAttestationResult": "wlp:PopAttestationResult",
    "PopEvidencePacket": "wlp:PopEvidencePacket",

    "AuthorshipReport": "wlp:AuthorshipReport",
    "EvidencePacket": "wlp:EvidencePacket",
    "WritingSession": "wlp:WritingSession",
    "CheckpointChain": "wlp:CheckpointChain",
    "Checkpoint": "wlp:Checkpoint",
    "VerificationResult": "wlp:VerificationResult",
    "ForensicEngine": "wlp:ForensicEngine",
    "DocumentArtifact": "wlp:DocumentArtifact",
    "ForensicExamination": "wlp:ForensicExamination",
    "DimensionScore": "wlp:DimensionScore",
    "ProcessEvidence": "wlp:ProcessEvidence",
    "ForgeryAssessment": "wlp:ForgeryAssessment",
