          "@type": "xsd:decimal"
        },
        "likelihoodModel": {
          "@id": "wlp:likelihoodModelScore",
          "@type": "xsd:decimal"
        },
        "compositionMode": {
          "@id": "wlp:compositionModeScore",
          "@type": "xsd:decimal"
        }
      }
