{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writerslogic.com/ns/v1/schemas/keystroke-cadence.schema.json",
  "title": "WritersProof Keystroke Cadence Assertion",
  "description": "C2PA custom assertion containing keystroke timing profile, dwell/flight metrics, correction patterns, fatigue trajectory, and spectral analysis. Label: com.writerslogic.keystroke-cadence",
  "type": "object",
  "required": ["version", "keystrokeCount", "sessionDurationSec", "timing", "dwell", "corrections"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "keystrokeCount": {
      "type": "integer",
      "minimum": 0
    },
    "sessionDurationSec": {
      "type": "number",
      "minimum": 0
    },
    "timing": {
      "type": "object",
      "required": ["meanIkiMs", "medianIkiMs", "coefficientOfVariation", "ikiPercentiles", "burstCount", "avgBurstLength", "pauseCount", "avgPauseDurationMs", "pauseDepthDistribution"],
      "properties": {
        "meanIkiMs": {
          "type": "number",
          "description": "Mean inter-keystroke interval in milliseconds"
        },
        "medianIkiMs": {
          "type": "number",
          "description": "Median IKI in milliseconds"
        },
        "coefficientOfVariation": {
          "type": "number",
          "description": "IKI standard deviation / mean. Below 0.15 = robotic"
        },
        "ikiPercentiles": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 5,
          "maxItems": 5,
          "description": "IKI percentiles [p10, p25, p50, p75, p90] in milliseconds"
        },
        "burstCount": {
          "type": "integer",
          "description": "Number of fast typing bursts (IKI below pause threshold)"
        },
        "avgBurstLength": {
          "type": "number",
          "description": "Mean keystrokes per burst"
        },
        "pauseCount": {
          "type": "integer",
          "description": "Number of pauses exceeding 2 seconds"
        },
        "avgPauseDurationMs": {
          "type": "number",
          "description": "Mean pause duration in milliseconds"
        },
        "pauseDepthDistribution": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Fraction of pauses in each depth tier: [sentence 1-3s, paragraph 3-10s, deep 10s+]"
        }
      }
    },
    "dwell": {
      "type": "object",
      "required": ["meanDwellMs", "dwellCv", "meanFlightMs", "flightCv"],
      "properties": {
        "meanDwellMs": {
          "type": "number",
          "description": "Mean key hold duration (keyDown to keyUp) in ms"
        },
        "dwellCv": {
          "type": "number",
          "description": "CV of dwell times. Human >0.2, robotic <0.1"
        },
        "meanFlightMs": {
          "type": "number",
          "description": "Mean release-to-press gap in ms"
        },
        "flightCv": {
          "type": "number",
          "description": "CV of flight times. Human >0.3"
        }
      }
    },
    "corrections": {
      "type": "object",
      "required": ["correctionRatio", "crossHandTimingRatio", "postPauseCv", "ikiAutocorrelation"],
      "properties": {
        "correctionRatio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Backspace/delete fraction of total keystrokes. Cognitive >0.05"
        },
        "crossHandTimingRatio": {
          "type": "number",
          "description": "Cross-hand vs same-hand IKI std dev ratio. Cognitive >1.3"
        },
        "postPauseCv": {
          "type": "number",
          "description": "CV of first 5 keystrokes after each pause. Cognitive >0.25"
        },
        "ikiAutocorrelation": {
          "type": "number",
          "description": "Lag-1 autocorrelation. Cognitive -0.1 to 0.2, transcriptive >0.3"
        }
      }
    },
    "fatigue": {
      "type": ["object", "null"],
      "properties": {
        "phase": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "0=warmup, 1=plateau, 2=fatigue"
        },
        "trajectoryResidual": {
          "type": "number",
          "description": "IKI trend residual; positive values indicate fatigue onset"
        }
      }
    },
    "spectral": {
      "type": ["object", "null"],
      "properties": {
        "slope": {
          "type": "number",
          "description": "FFT log-log PSD regression slope. Pink noise (biological) ~ -1.0"
        },
        "noiseType": {
          "type": "string",
          "enum": ["white", "pink", "brown"],
          "description": "Classified noise type from spectral slope"
        }
      }
    },
    "hurstExponent": {
      "type": ["number", "null"],
      "description": "Fractal dimension of timing. Human 0.6-0.8, random 0.5"
    },
    "biologicalCadenceScore": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Keystroke steadiness composite [0,1]"
    }
  }
}
