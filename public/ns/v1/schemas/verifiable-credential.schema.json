{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writerslogic.com/ns/v1/schemas/verifiable-credential.schema.json",
  "title": "WritersProof VC credentialSubject",
  "description": "Schema for the credentialSubject of a WritersProof ProcessAttestationCredential embedded in a C2PA manifest",
  "type": "object",
  "required": ["id", "type", "processAttestation"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Subject DID (author identity)"
    },
    "type": {
      "type": "string",
      "const": "ProcessAttestation"
    },
    "processAttestation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["human-authored", "mixed-input", "transcriptive", "insufficient"]
        },
        "trustVector": {
          "type": "object",
          "description": "EAR trust vector components (hardware, instance, executables)"
        },
        "documentRef": {
          "type": "string",
          "description": "SHA-256 hex hash of the attested document"
        },
        "chainDuration": {
          "type": "number",
          "description": "Evidence chain duration in seconds"
        },
        "attestationTier": {
          "type": "integer",
          "enum": [1, 2, 3]
        },
        "writingMode": {
          "type": "string"
        },
        "compositionMode": {
          "type": "string"
        },
        "forensicSignals": {
          "type": "object",
          "description": "15-field forensic enrichment from the 5 analysis dimensions",
          "properties": {
            "cognitiveLoadScore": { "type": "number" },
            "revisionTopologyScore": { "type": "number" },
            "errorEcologyScore": { "type": "number" },
            "likelihoodPCognitive": { "type": "number" },
            "compositionModeScore": { "type": "number" },
            "detourRatio": { "type": "number" },
            "leadingEdgeDivergence": { "type": "number" },
            "insertionPointEntropy": { "type": "number" },
            "wordsPerMinute": { "type": ["number", "null"] },
            "meanIkiMs": { "type": ["number", "null"] },
            "correctionRatio": { "type": ["number", "null"] },
            "keystrokeCount": { "type": ["integer", "null"] },
            "hurstExponent": { "type": ["number", "null"] },
            "forensicScore": { "type": ["number", "null"] }
          }
        }
      }
    }
  }
}
